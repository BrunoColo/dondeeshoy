# Search Console / SEO
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Cron / services
CRON_SECRET=replace-me
PASSLINE_API_URL=https://api.passline.com/v1/event/GetCountryByBillboardHome
# Optional: browser cookie string (e.g. cf_clearance=...; _cfuvid=...)
PASSLINE_COOKIE=
# Optional: custom user-agent for passline requests
PASSLINE_USER_AGENT=Mozilla/5.0 (Linux; Android 14) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/145.0.0.0 Mobile Safari/537.36
# Optional fallback endpoint returning the same JSON payload as Passline API
PASSLINE_FALLBACK_JSON_URL=
# Optional Authorization header for fallback endpoint (e.g. Bearer ...)
PASSLINE_FALLBACK_AUTH_HEADER=

# Supabase / Postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://YOUR-UPSTASH-INSTANCE.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-me

# OpenAI (pipeline IA)
OPENAI_API_KEY=replace-me
AI_CLASSIFICATION_MAX_PER_BATCH=25

# App
NEXT_PUBLIC_APP_URL=https://dondeeshoy.com
NEXT_PUBLIC_SITE_URL=https://dondeeshoy.com

# Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=pk.YOUR_MAPBOX_TOKEN

# Email
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
FROM_EMAIL=hola@dondeeshoy.com
ADMIN_EMAIL=admin@dondeeshoy.com

# Admin
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_SECRET=replace-with-a-long-random-secret
ADMIN_ACCESS_KEY=replace-with-a-secret-admin-url-key
ADMIN_ALLOWED_IPS=# Supabase (solo DB en MVP — sin Auth ni Storage)
DATABASE_URL=postgresql://postgres.xxx:xxx@aws-1-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_SERVICE_ROLE_KEY=xxx

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# OpenAI (pipeline IA)
OPENAI_API_KEY=sk-xxx

# Vercel Cron
CRON_SECRET=xxx

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co

# Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=pk.xxx

# Resend
RESEND_API_KEY=re_xxx
